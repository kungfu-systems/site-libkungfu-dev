{
  "schemaVersion": 1,
  "contract": "kungfu-buildchain-manual-upstream-pickup",
  "runtime": {
    "package": "@kungfu-tech/buildchain",
    "version": "4.0.2-alpha.39"
  },
  "downstream": {
    "id": "site-libkungfu-dev",
    "repository": "kungfu-systems/site-libkungfu-dev",
    "baseRef": "main",
    "executionProfile": {
      "contract": "kungfu-buildchain-github-web-surface-execution",
      "workflow": "buildchain-web-surface.yml",
      "productionReleaseLabel": "buildchain-release",
      "productionReleaseHeadPrefix": "release/",
      "productionStatusUrl": "https://libkungfu.dev/.well-known/kungfu-release-status.json",
      "readbackUrls": [
        "https://buildchain.libkungfu.dev/manifest.json",
        "https://core.libkungfu.dev/manifest.json"
      ],
      "updateCommand": "pnpm run site:update -- apply <capture.json> <claimed-work.json>",
      "prepareCommand": "pnpm install --lockfile-only --ignore-scripts",
      "verifyCommand": "pnpm run check"
    }
  },
  "sources": [
    {
      "id": "buildchain",
      "repository": "kungfu-systems/buildchain",
      "package": "@kungfu-tech/buildchain",
      "lockPath": "buildchain.upstreams/buildchain.release.json",
      "distTags": {
        "alpha": "alpha",
        "release": "latest"
      },
      "workflowPaths": [
        ".github/workflows/self-release-promote.yml"
      ],
      "workflowRefs": [
        "refs/heads/dev/v4/v4.0"
      ]
    },
    {
      "id": "kungfu-core",
      "repository": "kungfu-systems/kungfu",
      "package": "@kungfu-tech/site",
      "lockPath": "buildchain.upstreams/kungfu-core.release.json",
      "distTags": {
        "alpha": "alpha",
        "release": "latest"
      },
      "workflowPaths": [
        ".github/workflows/publish-layer-artifacts.yml"
      ],
      "workflowRefs": [
        "refs/heads/dev/v4/v4.0"
      ]
    }
  ]
}
