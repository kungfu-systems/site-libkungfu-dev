{
  "name": "site-libkungfu-dev",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "bash scripts/build-site.sh",
    "build:local-site-bundle": "bash scripts/build-local-site-bundle.sh",
    "check": "bash scripts/check-site.sh",
    "check:local-site-bundle": "node scripts/check-local-site-bundle.mjs",
    "check:dogfood": "node scripts/check-dogfood-evidence.mjs && node scripts/check-dogfood-history.mjs",
    "collect:agent-output-comparison": "node scripts/collect-agent-output-comparison.mjs",
    "collect:agent-output-comparisons": "node scripts/collect-agent-output-comparison.mjs --window bootstrap && node scripts/collect-agent-output-comparison.mjs --window operating",
    "check:agent-output-comparison": "node scripts/check-agent-output-comparison.mjs && node scripts/check-agent-output-comparison.mjs src/fixtures/agent-output-comparison-operating.snapshot.json",
    "check:paper-propagation": "node scripts/check-paper-propagation.cjs",
    "site:update": "node scripts/site-upstream-agent.cjs",
    "upstream:pickup": "node scripts/code-upstream-pickup.cjs",
    "installer:refresh": "node scripts/refresh-installer-catalog.mjs",
    "render": "node scripts/render-site.mjs"
  },
  "dependencies": {
    "@kungfu-tech/buildchain": "3.0.6-alpha.0",
    "@kungfu-tech/kfd": "1.0.0-alpha.66",
    "@kungfu-tech/paper-episodes-to-primitives": "0.1.0-alpha.2",
    "@kungfu-tech/paper-kfd-foundation-real-world-agent-work": "0.1.0-alpha.8",
    "@kungfu-tech/paper-kfd-machine-life-roadmap": "0.1.0-alpha.11",
    "@kungfu-tech/paper-kungfu-product-white-paper": "0.1.0-alpha.13",
    "@kungfu-tech/paper-kungfu-product-white-paper-agent-supply-chain": "npm:@kungfu-tech/paper-kungfu-product-white-paper@0.1.0-alpha.10",
    "@kungfu-tech/paper-observer-declared-timelines": "0.1.0-alpha.9",
    "@kungfu-tech/site": "4.0.0-alpha.1",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0"
  },
  "devDependencies": {
    "@kungfu-tech/buildchain-runtime": "npm:@kungfu-tech/buildchain@3.0.6-alpha.0"
  }
}
